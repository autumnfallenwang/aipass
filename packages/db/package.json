{
  "name": "@aipass/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests --exclude '**/*.int.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:integration": "vitest run .int.test --passWithNoTests --no-file-parallelism"
  },
  "dependencies": {
    "@aipass/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
