# Copy to .env (git-ignored). Defaults match deploy/compose.yaml.
DATABASE_URL=postgres://aipass:aipass@127.0.0.1:5433/aipass
FHIR_BASE_URL=http://127.0.0.1:8080/fhir

API_URL=http://localhost:3001
GATEWAY_URL=http://localhost:3002
WEB_URL=http://localhost:3000

# Required in production (32+ characters each); dev uses fixed, public values.
# BETTER_AUTH_SECRET=
# Seals people's upstream FHIR tokens and SMART client secrets in the vault (S6).
# AIPASS_VAULT_KEY=
# During a key change only: the old key(s), comma-separated (see docs/guides/own-fhir-server.md).
# AIPASS_VAULT_KEY_PREVIOUS=
