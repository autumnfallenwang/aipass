{
  "name": "aipass",
  "version": "0.0.0",
  "private": true,
  "description": "A pass for AI in healthcare: a permission gateway between AI agents and FHIR.",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm services:up && pnpm db:migrate && pnpm fixtures:load && pnpm db:seed && turbo dev",
    "services:up": "docker compose -f deploy/compose.yaml up -d --wait",
    "services:down": "docker compose -f deploy/compose.yaml down",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck && tsc -p .",
    "test": "turbo test",
    "test:integration": "turbo test:integration --concurrency=1",
    "fixtures:load": "tsx scripts/load-fixtures.ts",
    "smoke": "tsx scripts/smoke.ts",
    "db:migrate": "pnpm --filter @aipass/db db:migrate",
    "db:seed": "tsx apps/api/scripts/seed.ts",
    "pass": "tsx apps/api/scripts/pass.ts",
    "admin": "tsx apps/api/scripts/admin.ts",
    "test:e2e": "pnpm --filter @aipass/web test:e2e",
    "check": "tsx packages/check/src/cli.ts",
    "smart:url": "tsx scripts/smart-launcher-url.ts",
    "services:up:all": "docker compose -f deploy/compose.yaml --profile keycloak --profile smart up -d --wait",
    "vault:rotate": "tsx apps/api/scripts/vault-rotate.ts",
    "bundle": "tsx scripts/bundle.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.12.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
